{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Scripts run via `tsx`, which resolves and strips `.ts` extensions in
    // relative imports (e.g. `import { getSql } from './_db.ts'`). Allow the
    // explicit `.ts` extension so the typecheck matches how the scripts actually
    // run. Safe under `noEmit` (we never emit JS from this config).
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  // seed_demo_coaches.ts deliberately reuses the real WEB services via the web
  // `@/` alias (resolved by web/tsconfig.json at runtime, not infra's). It is
  // run with `--tsconfig ../web/tsconfig.json`, so exclude it from infra's tsc.
  "exclude": ["scripts/seed_demo_coaches.ts"]
}
