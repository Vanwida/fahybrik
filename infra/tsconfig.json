{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Scripts run via `tsx`, which resolves and strips `.ts` extensions in
    // relative imports (e.g. `import { getSql } from './_db.ts'`). Allow the
    // explicit `.ts` extension so the typecheck matches how the scripts actually
    // run. Safe under `noEmit` (we never emit JS from this config).
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  // Estos scripts reutilizan a propósito los SERVICIOS de web por el alias `@/`
  // (lo resuelve web/tsconfig.json en tiempo de ejecución, no el de infra). Se
  // lanzan con `--tsconfig ../web/tsconfig.json`, así que quedan fuera del tsc
  // de infra y los comprueba el de web.
  "exclude": [
    "scripts/seed_demo_coaches.ts",
    "scripts/seed_demo_draft_week.ts",
    "scripts/backfill_zone_seconds.ts"
  ]
}
