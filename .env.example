# =============================================================================
# FAHYBRID — environment variable template
# =============================================================================
# Placeholders only. NEVER commit real secrets here — those live in
# ~/.openclaw/credentials/vanwida-tokens.env locally and in Vercel project env.
# Values shown are empty or obvious examples (sk-..., https://...).
# =============================================================================

# Database (Neon Postgres)
DATABASE_URL=
NEON_PROJECT_ID=                          # infra tooling only (not read at runtime)
NEON_REGION=                              # infra tooling only (not read at runtime)
# Real-DB integration tests (web/tests/coach-integration/*). Point at a
# THROWAWAY Neon branch — never the prod DB. Create one with:
#   neonctl branches create --project-id $NEON_PROJECT_ID --name ci-tests
# then export its connection_uri here. If unset, the real-DB suites SKIP
# explicitly (visible in the report), they do NOT silently pass.
TEST_DATABASE_URL=

# Auth
AUTH_SECRET=                              # 32+ bytes random; HS256 JWT signing key
APPLE_CLIENT_ID=                          # iOS bundle id / service id (audience claim)
APPLE_TEAM_ID=                            # only needed for Apple revocation API
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
COACH_ALLOWLIST=                          # comma-separated coach emails allowed via magic link
COACH_DEMO_EMAIL=                         # fallback coach email when allowlist unset (e.g. pablo@fabrik.training)
COACH_DEMO_LOGIN=true                     # OPT-IN: only 'true' enables demo coach login (dev). Anything else = disabled. Ignored in prod unless ALLOW_DEMO_LOGIN_IN_PROD=true.
ALLOW_DEMO_LOGIN_IN_PROD=                 # 'true' to allow demo login when NODE_ENV=production (escape hatch; leave unset)

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=                        # e.g. "Fahybrid <noreply@fahybrid.com>"

# App URLs
APP_URL=                                  # https://dashboard.fahybrid.com (or http://localhost:3000)
NEXT_PUBLIC_APP_URL=                      # public base URL for client-built links (e.g. https://app.fahybrid.com)
NEXT_PUBLIC_ENV=                          # environment label for Sentry (e.g. production / preview / development)

# Garmin Health API (gated on partner approval — see /docs/garmin_oauth.md)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_OAUTH_CALLBACK_URL=                # https://app.fahybrid.com/api/garmin/callback
GARMIN_WEBHOOK_SECRET=                    # shared secret to verify inbound Garmin push webhooks

# AES-256-GCM key for encrypting OAuth tokens at rest. 32 bytes hex (or base64).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Cron (Vercel Cron — account-deletion runner, etc.)
CRON_SECRET=                              # Bearer token Vercel Cron sends; routes reject anything else with 401

# Storage (chat attachments / uploads)
BLOB_READ_WRITE_TOKEN=                    # Vercel Blob token (prod). Unset = local filesystem fallback.
UPLOADS_DIR=                              # local upload root when Blob unset (default /tmp/fahybrid-uploads)

# Push notifications (APNs — iOS)
APNS_BUNDLE_ID=                           # iOS app bundle id (apns topic)
APNS_KEY_ID=                              # 10-char APNs key id
APNS_PRIVATE_KEY=                         # .p8 contents; literal \n allowed (Vercel-friendly)
APNS_TEAM_ID=                             # 10-char Apple team id

# Stripe (web-first subscription billing — see /docs/billing/stripe-setup.md)
# Create the Products + Prices in the Stripe dashboard (NOT via API). Use test
# keys (sk_test_…) until going live. Missing core creds → 503.
STRIPE_SECRET_KEY=                        # sk_test_… (test mode) or sk_live_…
STRIPE_WEBHOOK_SECRET=                    # whsec_… from the dashboard webhook endpoint
# Per-tier price IDs (one Stripe Price each). plan_type → env mapping lives in
# web/lib/stripe/prices.ts. An unset tier → checkout returns 503 for that tier.
STRIPE_PRICE_ID_INDIVIDUAL=               # price_… individual tier (~70€/mes, 1 cuenta)
STRIPE_PRICE_ID_DOBLES=                   # price_… dobles tier (~115€/mes, 1 pago / 2 cuentas)
STRIPE_PRICE_ID_PRO=                      # price_… pro/elite tier (~95€/mes, 1 cuenta)
STRIPE_PORTAL_RETURN_URL=                 # https://app.fahybrik.com/perfil
STRIPE_CHECKOUT_SUCCESS_URL=              # post-checkout redirect
STRIPE_CHECKOUT_CANCEL_URL=               # checkout-abandoned redirect

# LLM — Alex picks models; never commit real keys
LLM_PROVIDER=openrouter                   # openrouter | azure-openai
LLM_API_KEY=
LLM_MODEL=                                # default model when LLM_CHAT_MODEL unset
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_EMBEDDING_MODEL=
LLM_AZURE_API_VERSION=                    # only when LLM_PROVIDER=azure-openai

# LLM chat tuning (coach chat + weekly proposal)
LLM_CHAT_MODEL=                           # e.g. deepseek/deepseek-v4-pro (OpenRouter)
LLM_CHAT_API_KEY=                         # optional override; default = LLM_API_KEY/OPENROUTER_API_KEY
LLM_CHAT_MAX_TOKENS=                      # default 8192
LLM_CHAT_MAX_TOKENS_WEEK=                 # default 4096 (weekly proposal)
LLM_CHAT_MAX_TOKENS_WORKOUT=              # output budget for workout-scoped chat
LLM_CHAT_TIMEOUT_MS=                      # default 120000
LLM_CHAT_PROVIDER_ORDER=alibaba           # OpenRouter slug — pin Alibaba Cloud Int.
LLM_CHAT_PROVIDER_FALLBACKS=false         # true = other providers if Alibaba busy

# OpenRouter (when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://fahybrid.com
OPENROUTER_APP_TITLE=FAHYBRID Coach

# Pablo IA Adapt — propuesta semanal (1 LLM). Sin set = fallback heurístico.
# Si vacío, ai-propose-week-adjustment usa LLM_CHAT_MODEL + LLM_API_KEY.
# Setea estos SOLO si quieres un modelo distinto para esta tarea.
PABLO_IA_MODEL=                           # opcional override, e.g. anthropic/claude-3.7-sonnet
PABLO_IA_API_KEY=                         # opcional override, default = LLM_API_KEY/OPENROUTER_API_KEY
PABLO_IA_PROVIDER=                        # opcional, default = LLM_PROVIDER (openrouter)

# Nutrición — estimación de macros por foto (vision LLM).
# Brain rule: NUNCA hardcodear modelo. Sin LLM_VISION_MODEL → POST /api/athlete/
# nutrition/photo responde 501 (no se elige modelo por defecto).
# Reusa LLM_PROVIDER / LLM_BASE_URL / OPENROUTER_API_KEY del resto del stack.
LLM_VISION_MODEL=                         # e.g. openai/gpt-4o, google/gemini-2.0-flash (OpenRouter)
LLM_VISION_MAX_TOKENS=                    # default 1024
LLM_VISION_TIMEOUT_MS=                    # default 60000

# Sentry (web/ + coach/)
# Vacíos = Sentry no se inicializa (zero-overhead local dev).
# Source-map upload sólo se activa cuando los 3 (AUTH_TOKEN + ORG + PROJECT) están seteados.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
