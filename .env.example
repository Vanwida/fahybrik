# Database (Neon Postgres)
DATABASE_URL=
NEON_PROJECT_ID=
NEON_REGION=

# Auth
AUTH_SECRET=                              # 32+ bytes random; HS256 JWT signing key
APPLE_CLIENT_ID=                          # iOS bundle id / service id (audience claim)
APPLE_TEAM_ID=                            # only needed for Apple revocation API
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
COACH_ALLOWLIST=                          # comma-separated coach emails allowed via magic link

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=                        # e.g. "Fahybrik <noreply@fahybrik.com>"

# App URL
APP_URL=                                  # https://dashboard.fahybrik.com (or http://localhost:3000)

# Garmin Health API (gated on partner approval — see /docs/garmin_oauth.md)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_OAUTH_CALLBACK_URL=                # https://app.fahybrik.com/api/garmin/callback

# AES-256-GCM key for encrypting OAuth tokens at rest. 32 bytes hex (or base64).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# LLM (set when chosen)
LLM_API_KEY=
