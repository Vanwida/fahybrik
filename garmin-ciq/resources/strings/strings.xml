<?xml version="1.0" encoding="utf-8"?>
<!--
  Idioma por defecto: español. Los atletas son de Barcelona.

  Criterio del copy: frases cortas, sin jerga y siempre con la SIGUIENTE ACCIÓN
  dentro. En una pantalla de 30 mm un "Error inesperado" no sirve de nada: si el
  reloj está lleno hay que decir que se borre desde Garmin Connect, y si no hay
  Bluetooth hay que decir que se acerque el móvil.
-->
<strings>
    <string id="AppName">FAHYBRID</string>

    <!-- Vinculación de la cuenta -->
    <string id="TitleLogin">Entra con tu email</string>
    <string id="BodyNeedsEmail">Escribe tu email en los ajustes de esta app en Garmin Connect.</string>
    <string id="TitleCode">Código de acceso</string>
    <string id="BodyNeedsCode">Te mandamos un código de 6 dígitos al email.</string>
    <string id="BodyCodeLength">El código son 6 dígitos. Revísalo en los ajustes del móvil.</string>
    <string id="BodyCodeSent">Mira tu email y escribe el código en los ajustes de esta app en Garmin Connect. Caduca en 10 minutos.</string>
    <string id="ErrBadCode">El código no vale o ha caducado. Pide uno nuevo.</string>
    <string id="ActionSendCode">Pedir código</string>
    <string id="ActionCheckCode">Ya lo he escrito</string>
    <string id="TitleExpired">Sesión caducada</string>
    <string id="BodyExpired">Vuelve a entrar con tu email.</string>

    <!-- En curso -->
    <string id="BusySendingCode">Enviando el código…</string>
    <string id="BusyVerifying">Comprobando el código…</string>
    <string id="BusySyncing">Buscando tu plan…</string>

    <!-- Estado -->
    <string id="TitleNoSession">Hoy no toca</string>
    <string id="BodyNoSession">No tienes sesión para hoy.</string>
    <string id="ActionStart">Empezar</string>
    <string id="TitlePlanViejo">Plan viejo</string>
    <string id="BodyPlanViejoA">Plan de hace </string>
    <string id="BodyPlanViejoB"> días. Acerca el móvil para actualizarlo.</string>
    <string id="TitleSinSoporte">Esta sesión va en la app</string>
    <string id="BodySinSoporte">Ábrela en la app del móvil. El reloj solo guía sesiones de correr por ahora.</string>
    <string id="TitleSinDetalle">Sin detalle</string>
    <string id="BodySinDetalle">Esta sesión no está en el reloj. Acerca el móvil y vuelve a probar.</string>
    <string id="TitlePlanIlegible">Plan ilegible</string>
    <string id="BodyPlanBad">El servidor ha contestado algo que el reloj no entiende. Vuelve a probar.</string>
    <string id="TitleStorageFull">Reloj lleno</string>
    <string id="BodyStorageFull">No queda sitio para el plan. Libera espacio en el reloj y vuelve a probar.</string>


    <!-- Fallos -->
    <string id="TitleNoConnection">Sin conexión</string>
    <string id="BodyNoConnection">Acerca el móvil con Bluetooth encendido, o conéctate al WiFi.</string>
    <string id="TitleError">Algo ha fallado</string>
    <string id="BodyErrorCode">No se ha podido cargar. Código</string>
    <string id="ActionRetry">Reintentar</string>

    <!-- Ajustes (se ven en Garmin Connect Mobile, no en el reloj) -->
    <string id="SettingsEmailTitle">Tu email</string>
    <string id="SettingsEmailPrompt">El email de tu cuenta.</string>
    <string id="SettingsCodeTitle">Código de acceso</string>
    <string id="SettingsCodePrompt">Los 6 dígitos que te hemos enviado por email. Se borra solo al usarlo.</string>
</strings>
