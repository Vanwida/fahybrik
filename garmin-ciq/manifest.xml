<?xml version="1.0"?>
<!--
  App de actividad Connect IQ del atleta: guía la sesión con motor propio, graba
  el FIT y envía el resultado al servidor (docs/garmin-reloj/modelo.md).

  · type="watch-app": la única clase de app que graba una actividad (`Fit`).
  · minSdkVersion 5.2.0: el suelo del nivel A (modelo.md §3).
  · Permisos: Communications (plan y resultado por el móvil), Positioning (GPS),
    Sensor (pulso), Fit (grabar la actividad), FitContributor (campos propios en
    el FIT). Nada de Background: no hay trabajo con la app cerrada.
  · La lista de relojes NO se escribe a mano: `python3 tools/generar-manifest.py`
    la regenera desde el SDK instalado.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="ActividadApp" id="b15052d0-89db-4463-9ffb-8b579c1e2188" launcherIcon="@Drawables.LauncherIcon" minSdkVersion="5.2.0" name="@Strings.AppName" type="watch-app">
        <iq:products>
            <!-- Enduro -->
            <iq:product id="enduro3"/>
            <!-- epix -->
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
